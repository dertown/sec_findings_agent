<form version="1.1" theme="dark" stylesheet="dashboard.css">
  <label>Evidence search catalog</label>
  <description>SPL recommendations the app attaches to a finding. Templates activate when the required entities (user, src, hash, domain, and so on) are present.</description>
  <fieldset submitButton="true" autoRun="true">
    <input type="dropdown" token="mode">
      <label>Data source</label>
      <choice value="demo">Demo findings</choice>
      <choice value="rest">ES Mission Control API</choice>
      <default>demo</default>
    </input>
    <input type="text" token="finding_id">
      <label>Finding ID (optional)</label>
      <default></default>
    </input>
    <input type="dropdown" token="category" searchWhenChanged="true">
      <label>Category</label>
      <choice value="*">All</choice>
      <choice value="Authentication">Authentication</choice>
      <choice value="Network">Network</choice>
      <choice value="Endpoint">Endpoint</choice>
      <choice value="DNS">DNS</choice>
      <choice value="Web">Web</choice>
      <choice value="Email">Email</choice>
      <choice value="Malware">Malware</choice>
      <choice value="Threat intel">Threat intel</choice>
      <choice value="ES findings">ES findings</choice>
      <choice value="Risk">Risk</choice>
      <choice value="Asset">Asset</choice>
      <choice value="Identity">Identity</choice>
      <choice value="Triage">Triage</choice>
      <default>*</default>
    </input>
  </fieldset>
  <row>
    <panel>
      <title>Built-in templates</title>
      <table>
        <search>
          <query>| inputlookup search_templates.csv | where match(category,"$category$") | table priority, category, name, purpose, evidence_class, base_weight, requires, mitre, spl</query>
        </search>
        <option name="count">30</option>
        <option name="wrap">true</option>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/search/search?q=$row.spl|u$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Rendered searches for findings</title>
      <table>
        <search>
          <query>| loadfindings mode=$mode$ finding_id=$finding_id$ expand=searches limit=50 | where match(search_category,"$category$") | sort finding_id, search_priority | table finding_id, title, followup_score, investigation_required, search_category, search_name, potential_weight, search_purpose, search_spl</query>
        </search>
        <option name="count">30</option>
        <option name="wrap">true</option>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/search/search?q=$row.search_spl|u$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
</form>
