<form version="1.1" theme="dark" stylesheet="dashboard.css,judge_manager.css" script="judge_manager.js">
  <label>Judge manager</label>
  <description>Add rule or Python judge functions for the Finding Evidence Agent. Judges vote, adjust, or override the follow-up score. Every cycle still posts the full result onto the ES finding as enrichment.</description>
  <row>
    <panel>
      <html>
        <div class="fea-help">
          <h2>How judges work</h2>
          <p>The agent runs every enabled judge after it gathers evidence. Built-in judges ship with the app. <b>UI judges</b> you add here are stored in KV store; Python judges are also written under <code>local/judges/</code> after source checks.</p>
          <ul>
            <li><b>vote</b> — weighted average of the judge score</li>
            <li><b>adjust</b> — add <code>adjustment</code> points to the running score</li>
            <li><b>override</b> — if the judge returns a decision, that decision wins</li>
          </ul>
          <p>Python judges must define <code>def judge(finding, evidence, searches, context)</code> and may not import <code>os</code>/<code>sys</code> or use eval, exec, subprocess, or network libraries.</p>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <title>Configured judges</title>
      <table>
        <search>
          <query>| listjudges | table name, source, type, enabled, mode, weight, decision, rationale, editable</query>
          <earliest>-1s</earliest>
          <latest>now</latest>
        </search>
        <option name="count">30</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
        <format type="color" field="enabled">
          <colorPalette type="map">{"1":#53a051,"0":#555555}</colorPalette>
        </format>
        <format type="color" field="source">
          <colorPalette type="map">{"ui":#7ec8e3,"builtin":#f8be34,"conf":#9aa5b1}</colorPalette>
        </format>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <html>
        <div id="fea-judge-app" class="fea-judge">
          <h2>Add or update a judge</h2>
          <p class="fea-judge-status" id="fea-judge-status"></p>
          <div class="fea-judge-grid">
            <label>Name <input id="fea-name" type="text" placeholder="force_vip_user" /></label>
            <label>Type
              <select id="fea-type">
                <option value="rule">Rule (no Python)</option>
                <option value="python">Python function</option>
              </select>
            </label>
            <label>Mode
              <select id="fea-mode">
                <option value="vote">vote</option>
                <option value="adjust">adjust</option>
                <option value="override">override</option>
              </select>
            </label>
            <label>Weight <input id="fea-weight" type="number" step="0.05" value="1" /></label>
            <label>Enabled
              <select id="fea-enabled">
                <option value="1">Yes</option>
                <option value="0">No</option>
              </select>
            </label>
            <label>Decision (override) <input id="fea-decision" type="text" placeholder="Yes | Review | No" /></label>
            <label>Score <input id="fea-score" type="number" step="1" placeholder="90" /></label>
            <label>Adjustment <input id="fea-adjustment" type="number" step="1" value="0" /></label>
            <label class="fea-span">Rationale <input id="fea-rationale" type="text" placeholder="SOC policy" /></label>
            <label>when_urgency <input id="fea-when_urgency" type="text" placeholder="critical,high" /></label>
            <label>when_status <input id="fea-when_status" type="text" /></label>
            <label>when_disposition <input id="fea-when_disposition" type="text" /></label>
            <label>when_triage_disposition <input id="fea-when_triage_disposition" type="text" placeholder="true_positive" /></label>
            <label>when_min_risk <input id="fea-when_min_risk" type="text" placeholder="80" /></label>
            <label>when_title_contains <input id="fea-when_title_contains" type="text" /></label>
            <label class="fea-span">when_user_in <input id="fea-when_user_in" type="text" placeholder="admin,root" /></label>
            <label class="fea-span fea-python-wrap">Python source
              <textarea id="fea-python" rows="10" spellcheck="false">def judge(finding, evidence, searches, context):
    if finding.get("user") == "admin":
        return {"score": 85, "decision": "Yes", "mode": "override", "rationale": "admin account"}
    return {"abstain": True}
</textarea>
            </label>
          </div>
          <div class="fea-judge-actions">
            <button id="fea-save" class="btn btn-primary" type="button">Save judge</button>
            <button id="fea-delete" class="btn" type="button">Delete UI judge</button>
          </div>
        </div>
      </html>
    </panel>
  </row>
</form>
