<form version="1.1" theme="dark" stylesheet="dashboard.css" script="agent_ops.js">
  <label>Agent activity</label>
  <description>See what the Finding Evidence Agent is doing. Every cycle posts the score, judges, evidence, and searches onto the ES finding as enrichment. Owner, status, urgency, and disposition are not changed.</description>
  <fieldset submitButton="true" autoRun="true">
    <input type="dropdown" token="mode">
      <label>Finding source</label>
      <choice value="demo">Demo findings</choice>
      <choice value="rest">ES Mission Control API</choice>
      <choice value="auto">Auto</choice>
      <default>demo</default>
    </input>
    <input type="dropdown" token="run_searches">
      <label>Run evidence searches</label>
      <choice value="true">Yes (backend gathers hits)</choice>
      <choice value="false">No (score only)</choice>
      <default>true</default>
    </input>
    <input type="text" token="limit">
      <label>Finding limit</label>
      <default>12</default>
    </input>
    <input type="dropdown" token="live">
      <label>Live preview</label>
      <choice value="no">Persisted activity only</choice>
      <choice value="yes">Also run a live preview cycle</choice>
      <default>no</default>
      <change>
        <condition value="yes">
          <set token="live_yes">1</set>
        </condition>
        <condition>
          <unset token="live_yes"></unset>
        </condition>
      </change>
    </input>
  </fieldset>
  <row>
    <panel>
      <html>
        <div class="fea-help">
          <h2>How the agent works</h2>
          <ol>
            <li>Load ES findings (or demo samples).</li>
            <li><b>gather_evidence</b> — run the top recommended SPL searches on this search head.</li>
            <li><b>score</b> — run built-in, conf, and Splunk Web judges.</li>
            <li><b>enrich</b> — write the full result onto the ES finding (Mission Control note + <code>fea_*</code> fields). Workflow fields are not touched.</li>
            <li><b>persist / emit</b> — KV store + <code>fea:agent:result</code> events for this dashboard.</li>
          </ol>
          <p>Add judges in <b>Judge manager</b>. Scheduled backend: Settings → Data inputs → Finding Evidence Agent (disabled out of the box).</p>
          <p class="fea-judge-status" id="fea-agent-status"></p>
          <p><button id="fea-run-agent" class="btn btn-primary" type="button">Run agent cycle now</button></p>
        </div>
      </html>
    </panel>
  </row>
  <row>
    <panel>
      <single>
        <title>Findings scored (KV)</title>
        <search>
          <query>| inputlookup finding_evidence_scores | stats count</query>
        </search>
      </single>
    </panel>
    <panel>
      <single>
        <title>Enrichment posted</title>
        <search>
          <query>| listenrichment | stats count(eval(enrichment_posted=1)) as count</query>
        </search>
        <option name="underLabel">onto findings</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Investigation required</title>
        <search>
          <query>| inputlookup finding_evidence_scores | stats count(eval(investigation_required="Yes")) as count</query>
        </search>
        <option name="colorBy">value</option>
        <option name="rangeColors">["0x53a051","0xf8be34","0xdc4e41"]</option>
        <option name="rangeValues">[1,5]</option>
        <option name="useColors">1</option>
      </single>
    </panel>
    <panel>
      <single>
        <title>Enabled judges</title>
        <search>
          <query>| listjudges | where enabled=1 | stats count</query>
        </search>
      </single>
    </panel>
  </row>
  <row>
    <panel>
      <title>Last scored findings (persisted)</title>
      <table>
        <search>
          <query>| inputlookup finding_evidence_scores | sort - followup_score | table followup_score, investigation_required, enrichment_posted, override_applied, finding_id, title, urgency, triage_disposition, executed_search_count, evidence_net_weight, agent_tasks, enrichment_error</query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <format type="color" field="followup_score">
          <colorPalette type="list">[#53a051,#f8be34,#f1813f,#dc4e41]</colorPalette>
          <scale type="threshold">30,50,75</scale>
        </format>
        <format type="color" field="investigation_required">
          <colorPalette type="map">{"Yes":#dc4e41,"Review":#f8be34,"No":#53a051}</colorPalette>
        </format>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/es_finding_evidence/finding_workbench?form.finding_id=$row.finding_id$&form.mode=$mode$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Enrichment written onto findings</title>
      <table>
        <search>
          <query>| listenrichment | sort - _time | table finding_id, title, fea_followup_score, fea_investigation_required, fea_investigation_label, enrichment_posted, fea_executed_search_count, fea_override_applied, fea_agent_summary, enrichment_error</query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <format type="color" field="fea_investigation_required">
          <colorPalette type="map">{"Yes":#dc4e41,"Review":#f8be34,"No":#53a051}</colorPalette>
        </format>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/es_finding_evidence/finding_workbench?form.finding_id=$row.finding_id$&form.mode=$mode$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Indexed agent cycles</title>
      <table>
        <search>
          <query>sourcetype=fea:agent:cycle | sort - _time | table _time, count, elapsed, mode, tasks, errors</query>
          <earliest>-7d</earliest>
          <latest>now</latest>
        </search>
        <option name="count">15</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
    <panel>
      <title>Indexed per-finding results</title>
      <table>
        <search>
          <query>sourcetype=fea:agent:result | sort - _time | table _time, finding_id, title, followup_score, investigation_required, executed_search_count, enrichment_posted, override_applied</query>
          <earliest>-7d</earliest>
          <latest>now</latest>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/es_finding_evidence/finding_workbench?form.finding_id=$row.finding_id$&form.mode=$mode$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel>
      <title>Judges in this cycle</title>
      <table>
        <search>
          <query>| listjudges | table name, source, type, enabled, mode, weight, decision, rationale</query>
        </search>
        <option name="count">30</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$live_yes$">
      <title>Live preview cycle (scored findings)</title>
      <table>
        <search>
          <query>| findingagent mode=$mode$ run_searches=$run_searches$ limit=$limit$ | sort - followup_score | table followup_score, investigation_required, enrichment_posted, override_applied, finding_id, title, urgency, triage_disposition, executed_search_count, evidence_net_weight, agent_tasks</query>
        </search>
        <option name="count">20</option>
        <option name="drilldown">row</option>
        <option name="wrap">true</option>
        <format type="color" field="followup_score">
          <colorPalette type="list">[#53a051,#f8be34,#f1813f,#dc4e41]</colorPalette>
          <scale type="threshold">30,50,75</scale>
        </format>
        <format type="color" field="investigation_required">
          <colorPalette type="map">{"Yes":#dc4e41,"Review":#f8be34,"No":#53a051}</colorPalette>
        </format>
        <drilldown>
          <link target="_blank">
            <![CDATA[/app/es_finding_evidence/finding_workbench?form.finding_id=$row.finding_id$&form.mode=$mode$]]>
          </link>
        </drilldown>
      </table>
    </panel>
  </row>
  <row>
    <panel depends="$live_yes$">
      <title>Live preview — judge votes</title>
      <table>
        <search>
          <query>| findingagent mode=$mode$ run_searches=$run_searches$ limit=$limit$ | spath input=judges_json path={} output=j | mvexpand j | eval name=spath(j,"name"), decision=spath(j,"decision"), score=spath(j,"score"), mode=spath(j,"mode"), abstain=spath(j,"abstain"), rationale=spath(j,"rationale") | table finding_id, name, mode, score, decision, abstain, rationale</query>
        </search>
        <option name="count">40</option>
        <option name="drilldown">none</option>
        <option name="wrap">true</option>
      </table>
    </panel>
  </row>
</form>
